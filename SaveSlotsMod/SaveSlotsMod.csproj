<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SaveSlotsMod</AssemblyName>
    <RootNamespace>SaveSlotsMod</RootNamespace>
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Укажи путь к папке с игрой Inscryption здесь,
      или передай через командную строку:
        dotnet build -c Release /p:GameFolder="D:\FIleENG\Inscryption"
    -->
    <GameFolder Condition="'$(GameFolder)' == ''">D:\FIleENG\Inscryption</GameFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- ── BepInEx ───────────────────────────────────────────────────────── -->
    <Reference Include="BepInEx">
      <HintPath>$(GameFolder)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameFolder)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- ── Unity core ────────────────────────────────────────────────────── -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameFolder)\Inscryption_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameFolder)\Inscryption_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameFolder)\Inscryption_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameFolder)\Inscryption_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameFolder)\Inscryption_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameFolder)\Inscryption_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameFolder)\Inscryption_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameFolder)\Inscryption_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- ── InscryptionAPI ───────────────────────────────────────────────── -->
    <Reference Include="InscryptionAPI"
               Condition="Exists('$(GameFolder)\BepInEx\plugins\InscryptionAPI.dll')">
      <HintPath>$(GameFolder)\BepInEx\plugins\InscryptionAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InscryptionAPI"
               Condition="!Exists('$(GameFolder)\BepInEx\plugins\InscryptionAPI.dll') And
                           Exists('$(GameFolder)\BepInEx\plugins\API\InscryptionAPI.dll')">
      <HintPath>$(GameFolder)\BepInEx\plugins\API\InscryptionAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InscryptionAPI"
               Condition="!Exists('$(GameFolder)\BepInEx\plugins\InscryptionAPI.dll') And
                          !Exists('$(GameFolder)\BepInEx\plugins\API\InscryptionAPI.dll') And
                           Exists('$(GameFolder)\BepInEx\plugins\InscryptionAPI\InscryptionAPI.dll')">
      <HintPath>$(GameFolder)\BepInEx\plugins\InscryptionAPI\InscryptionAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- ── Game assembly ─────────────────────────────────────────────────── -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameFolder)\Inscryption_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\public\cursor.png">
      <LogicalName>SaveSlotsMod.cursor.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
